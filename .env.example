# AI Assistant Multi-LLM API Keys (Optional)
# Configure one of the following API keys to enable live LLM models (ChatGPT / Claude / Gemini).
# If no key is set, the AI Assistant will seamlessly use the built-in portfolio knowledge engine.

# OpenAI ChatGPT (Model: gpt-4o-mini / gpt-3.5-turbo)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Model: claude-3-5-haiku-20241022)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (Model: gemini-1.5-flash)
# GEMINI_API_KEY=your_gemini_api_key_here
